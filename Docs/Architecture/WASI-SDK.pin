# Pinned Swift WASI SDK (Phase 1 hard gate).
# Full Swift-Wasm extension builds are Phase 11.
# CI job `wasi-sdk` always requires this SDK present (installs if missing).
#
# First non-comment, non-empty, non-KEY= line is the SDK id substring matched by `swift sdk list`.
# INSTALL_URL / INSTALL_CHECKSUM are used by scripts/check-wasi-sdk.sh when the SDK is absent.

INSTALL_URL=https://download.swift.org/swift-6.3.3-release/wasm-sdk/swift-6.3.3-RELEASE/swift-6.3.3-RELEASE_wasm.artifactbundle.tar.gz
INSTALL_CHECKSUM=cabfa08b73bb8ac783927ecd15fa386e99d0c139c5f232445067bcf58379cae7

swift-6.3.3-RELEASE_wasm
